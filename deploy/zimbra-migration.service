[Unit]
Description=Zimbra IMAP Migration Panel
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=zimbra-migrator
Group=zimbra-migrator
WorkingDirectory=/opt/zimbra-migration
EnvironmentFile=/opt/zimbra-migration/.env
ExecStart=/opt/zimbra-migration/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/zimbra-migration/data /opt/zimbra-migration/logs

[Install]
WantedBy=multi-user.target
