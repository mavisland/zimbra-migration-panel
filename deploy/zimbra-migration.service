[Unit]
Description=Zimbra IMAP Migration Panel
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=zimbra-migrator
Group=zimbra-migrator
WorkingDirectory=/opt/zimbra-migration
EnvironmentFile=/opt/zimbra-migration/.env
ExecStart=/opt/zimbra-migration/.venv/bin/python /opt/zimbra-migration/app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/zimbra-migration/data /opt/zimbra-migration/data/pids /opt/zimbra-migration/logs

[Install]
WantedBy=multi-user.target
